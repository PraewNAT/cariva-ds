{
  "name": "cariva-design-system",
  "version": "0.1.1",
  "description": "Cariva Core Design System — React + MUI components, tokens, and theme.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/PraewNAT/cariva-ds.git",
    "directory": "code/core"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@mui/material": "^7.1.0",
    "@mui/icons-material": "^7.1.0",
    "@mui/x-date-pickers": "^7.23.3",
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "dayjs": "^1.11.13"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.8.2"
  }
}
