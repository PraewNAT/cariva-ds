{
  "name": "@agent/peer-bridge",
  "version": "0.1.8",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npx tsx src/index.ts",
    "start:supervised": "npx tsx scripts/watchdog.ts",
    "check-env": "npx tsx src/check-env.ts",
    "probe": "npx tsx src/agent-probe.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:ds": "tsc -p tsconfig.ds.json",
    "test": "vitest",
    "test:run": "vitest run",
    "code-connect:dry-run": "bash scripts/code-connect.sh publish --dry-run",
    "code-connect:publish": "bash scripts/code-connect.sh publish",
    "icons:custom": "node scripts/generate-custom-icons.js",
    "icons:connect": "node scripts/generate-icon-connect.js",
    "tokens:generate": "node scripts/generate-tokens.js",
    "tokens:check": "node scripts/generate-tokens.js --check",
    "export:dev": "bash scripts/export-dev.sh",
    "export:check": "bash scripts/export-dev.sh --check",
    "peer:wizard": "node scripts/peer-wizard.mjs",
    "storybook": "storybook dev -p 6006 --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry"
  },
  "dependencies": {
    "@connectrpc/connect-node": "^1.6.1",
    "@cursor/sdk": "^1.0.13",
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@fontsource/ibm-plex-sans-thai": "^5.3.0",
    "@mui/icons-material": "^7.1.0",
    "@mui/material": "^7.1.0",
    "@mui/x-date-pickers": "^7.23.3",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@figma/code-connect": "^1.5.3",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/blocks": "^8.6.18",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "storybook": "^8.6.18",
    "typescript": "^5.8.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
