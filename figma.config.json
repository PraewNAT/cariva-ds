{
  "codeConnect": {
    "parser": "react",
    "importPaths": {
      "code/core/components/*": "@/components/*",
      "code/core/icons/*": "@/icons/*"
    },
    "include": [
      "code/core/components/**/*.figma.tsx",
      "code/core/components/**/*.tsx",
      "code/core/icons/**/*.tsx",
      "code-connect/**/*.figma.tsx"
    ],
    "exclude": [
      "node_modules/**",
      "**/*.stories.tsx",
      "**/*.test.tsx"
    ]
  }
}
